ALPACA_API_KEY=your_paper_key
ALPACA_SECRET_KEY=your_paper_secret
ALPACA_PAPER_TRADE=true

# LLM trade dictator
# Groq (recommended free/cheap): https://console.groq.com/keys
GROQ_API_KEY=
LLM_API_KEY=
# Groq:   https://api.groq.com/openai/v1  + qwen/qwen3.8-27b (or openai/gpt-oss-20b)
# OpenAI: https://api.openai.com/v1       + gpt-4o-mini
# xAI:    https://api.x.ai/v1             + grok-2-latest
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
# Keep under Groq free OTPM (~1000). Default in code is 400.
LLM_MAX_TOKENS=400


# Strategy
MOVERS_TOP=30
LONG_SLOTS=3
SHORT_SLOTS=3
MIN_PRICE=15
MIN_PCT_MOVE=2
MAX_PCT_MOVE=25

# Risk
RISK_PER_POSITION_PCT=2
MAX_DAILY_LOSS_PCT=3
STOP_LOSS_PCT=4
TAKE_PROFIT_PCT=8

# Runtime
POLL_SECONDS=300
DRY_RUN=false
ONCE=false

# Dashboard (open on phone/laptop)
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8787
DASHBOARD_PASSWORD=changeme
DASHBOARD_TOKEN=replace-with-long-random-token
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
